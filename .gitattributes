# 统一文本文件换行符：仓库内一律 LF，检出时按平台/客户端设置处理
* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制资源，禁止换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.jar   binary
*.jks   binary
*.keystore binary
*.ap_   binary
*.dex   binary
*.so    binary
*.apk   binary
*.aab   binary
*.zip   binary
*.gz    binary
