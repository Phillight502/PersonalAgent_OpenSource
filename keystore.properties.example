# 正式签名配置模板：复制为 keystore.properties 并填入真实值。
# keystore.properties 已被 .gitignore 忽略，永远不会入库。
#
# 1. 生成自己的 keystore（只需一次）：
#    keytool -genkeypair -v -keystore personalagent.jks -keyalg RSA -keysize 2048 \
#      -validity 10000 -alias personalagent
# 2. 复制本文件：cp keystore.properties.example keystore.properties
# 3. 按实际情况修改下面四项；storeFile 相对路径基于 app/ 模块目录
storeFile=../personalagent.jks
storePassword=your_store_password
keyAlias=personalagent
keyPassword=your_key_password
